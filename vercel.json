{
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/admin/recalculate-entitlements",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/cloudinary/sign",
      "destination": "/api/cloudinary/sign"
    },
    {
      "source": "/api/orders/create",
      "destination": "/api/orders/create"
    },
    {
      "source": "/api/orders/list",
      "destination": "/api/orders/list"
    },
    {
      "source": "/api/orders/status",
      "destination": "/api/orders/status"
    },
    {
      "source": "/api/admin/recalculate-entitlements",
      "destination": "/api/admin/recalculate-entitlements"
    },
    {
      "source": "/api/ai/chat",
      "destination": "/api/ai/chat"
    },
    {
      "source": "/api/ai/describe",
      "destination": "/api/ai/describe"
    },
    {
      "source": "/api/ai/image/generate",
      "destination": "/api/ai/image/generate"
    },
    {
      "source": "/api/ai/image/enhance",
      "destination": "/api/ai/image/enhance"
    },
    {
      "source": "/((?!api/|sw\\.js|manifest\\.json|manifest\\.webmanifest|.*\\.(?:png|jpg|jpeg|gif|svg|ico|json|js|css|webp|woff2?)).*)",
      "destination": "/index.html"
    }
  ]
}
