rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'foosco80@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Helper to check if vendor account is active (not suspended by admin)
    // An absent private user document cannot be treated as an active merchant.
    function isVendorActive(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)) &&
        !(get(/databases/$(database)/documents/users/$(uid)).data.status in ['Inactif', 'Suspendu']);
    }

    // List of protected sensitive fields related to subscriptions, privileges and account status
    function hasSensitiveSubscriptionFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'role',
        'status',
        'plan',
        'trialStartedAt',
        'trialEndsAt',
        'date_expiration_essai',
        'vipStartedAt',
        'vipEndsAt'
      ]);
    }

    // Protection of public store entitlements:
    // A vendor can NEVER alter hasFullCatalog, is_active, or inject subscription/role fields
    function vendorTamperingPublicStoreEntitlements() {
      return (
        ('hasFullCatalog' in request.resource.data &&
         (!('hasFullCatalog' in resource.data) || request.resource.data.hasFullCatalog != resource.data.hasFullCatalog)) ||
        ('is_active' in request.resource.data &&
         (!('is_active' in resource.data) || request.resource.data.is_active != resource.data.is_active)) ||
        ('role' in request.resource.data) ||
        ('status' in request.resource.data) ||
        ('plan' in request.resource.data) ||
        ('vipStartedAt' in request.resource.data) ||
        ('vipEndsAt' in request.resource.data) ||
        ('trialStartedAt' in request.resource.data) ||
        ('trialEndsAt' in request.resource.data) ||
        ('date_expiration_essai' in request.resource.data)
      );
    }

    // 1. Users collection (Vendeurs & Admins) - STRICTEMENT PRIVÉ
    match /users/{uid} {
      // Private profile: ONLY readable by authenticated owner or authorized admin
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();

      // Create: User can create their own document
      // A seller can create their profile without being forced to set subscription fields,
      // and cannot self-assign VIP status, VIP plan, admin role, or VIP dates.
      allow create: if isOwner(uid) && 
        request.resource.data.uid == uid &&
        (
          isAdmin() ||
          (
            (!('role' in request.resource.data) || request.resource.data.role == 'seller') &&
            (!('status' in request.resource.data) || request.resource.data.status in ['Actif', 'Essai', 'Gratuit']) &&
            (!('plan' in request.resource.data) || request.resource.data.plan in ['Essai', 'Gratuit']) &&
            !('vipStartedAt' in request.resource.data) &&
            !('vipEndsAt' in request.resource.data)
          )
        );

      // Update: Owner can update ordinary profile fields (name, logo, slogan, location, whatsapp, etc.)
      // but CANNOT modify any sensitive subscription or privilege fields.
      // Only an authorized admin can update role, status, plan, trial dates, or VIP dates.
      allow update: if (
        isOwner(uid) && request.resource.data.uid == uid && !hasSensitiveSubscriptionFields()
      ) || isAdmin();

      // Delete: Only admin can delete account
      allow delete: if isAdmin();

      // 2. Products sub-collection: Scoped under users/{uid}/products/{productId}
      match /products/{productId} {
        // Public can view products for this vendor's store
        allow read: if true;

        // Only an active vendor owner can create or update products. Suspended or inactive accounts cannot.
        allow create: if isOwner(uid) && isValidId(productId) && request.resource.data.vendeur_id == uid && isVendorActive(uid);
        allow update: if (isOwner(uid) && request.resource.data.vendeur_id == uid && isVendorActive(uid)) || isAdmin();
        allow delete: if isOwner(uid) || isAdmin();
      }

      // 3. Prospects sub-collection: Scoped under users/{uid}/prospects/{prospectId}
      match /prospects/{prospectId} {
        // Strictly private CRM: Only the vendor owner can read or write
        allow read, write: if isOwner(uid) || isAdmin();
      }
    }

    // 2. Public Stores collection (/publicStores/{uid}) - PROFIL PUBLIC DÉDIÉ
    match /publicStores/{uid} {
      // Public can read seller storefront info for catalog display & searching by slug
      allow get: if true;
      allow list: if true;

      // Create: Admin or trusted backend can initialize storefront with full entitlements.
      // An ordinary owner can only create basic commercial details:
      // - hasFullCatalog CANNOT be set to true by an ordinary seller (must be omitted or false)
      // - is_active CANNOT be created if vendor account is suspended or inactive
      // - Seller cannot self-assign VIP status, VIP plan, or VIP dates
      allow create: if (
        isOwner(uid) && 
        request.resource.data.id == uid &&
        (
          isAdmin() ||
          (
            isVendorActive(uid) &&
            (!('hasFullCatalog' in request.resource.data) || request.resource.data.hasFullCatalog == false) &&
            (!('is_active' in request.resource.data) || request.resource.data.is_active == true) &&
            !('role' in request.resource.data) &&
            !('status' in request.resource.data) &&
            !('plan' in request.resource.data) &&
            !('vipStartedAt' in request.resource.data) &&
            !('vipEndsAt' in request.resource.data) &&
            !('trialStartedAt' in request.resource.data) &&
            !('trialEndsAt' in request.resource.data) &&
            !('date_expiration_essai' in request.resource.data)
          )
        )
      ) || isAdmin();

      // Update: Owner can update ordinary public fields (name, logo, slogan, location, currency, publicSlug, orderWhatsApp, allowCommercialContact, updatedAt)
      // BUT A SELLER CAN NEVER alter hasFullCatalog or is_active to bypass subscription or reactivate a suspended store.
      // Only the authorized admin can update access rights (hasFullCatalog, is_active) or modify subscription statuses.
      allow update: if (
        isOwner(uid) && 
        request.resource.data.id == uid && 
        !vendorTamperingPublicStoreEntitlements()
      ) || isAdmin();

      // Delete: Only authorized admin can delete public storefront.
      // A seller CANNOT delete and recreate their publicStore to bypass expired trial or suspension!
      allow delete: if isAdmin();
    }

    // 4. Global Settings: Read by all, modified only by admin
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Analytics events: Telemetry logging for views, clicks & conversions
    match /analytics/{eventId} {
      // Anyone can log an interaction event (page view, WhatsApp click)
      allow create: if isValidId(eventId) && request.resource.data.vendeur_id is string;
      
      // Only the vendor owner or admin can read their metrics
      allow read: if isSignedIn() && (
        resource.data.vendeur_id == request.auth.uid || isAdmin()
      );
      allow update, delete: if isAdmin();
    }
  }
}
